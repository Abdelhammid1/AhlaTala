FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# PostgreSQL 16 (local)
DATABASE_URL=postgresql+psycopg://ahla_tolla:changeme@127.0.0.1:5432/ahla_tolla

SECRET_KEY=change-me-in-production-please
JWT_SECRET_KEY=change-me-in-production-please

# Where uploaded images live (relative to backend/app/static/)
UPLOAD_ROOT=uploads

# Seeded admin credentials (used only by `flask seed`)
ADMIN_EMAIL=admin@ahlatolla.local
ADMIN_PASSWORD=admin

# E2 — checkout settings (exposed via /api/v1/settings)
DELIVERY_FEE=15.00
CURRENCY=SAR
