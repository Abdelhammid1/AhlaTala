FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=1

# PostgreSQL 16 (local)
DATABASE_URL=postgresql+psycopg://ahla_tolla:changeme@127.0.0.1:5432/ahla_tolla

SECRET_KEY=change-me-in-production-please
JWT_SECRET_KEY=change-me-in-production-please

# Where uploaded images live (relative to backend/app/static/)
UPLOAD_ROOT=uploads

# Seeded admin credentials (used only by `flask seed`)
ADMIN_EMAIL=admin@ahlatolla.local
ADMIN_PASSWORD=admin

# E2 — checkout settings (exposed via /api/v1/settings)
DELIVERY_FEE=15.00
CURRENCY=SAR

# App Store / Play Store reviewer bypass — a specific phone/code combo that
# skips the real OTP send + verify so Apple + Google reviewers can log in
# without receiving an SMS. Both must be set; leave blank/unset to disable.
# Rotate whenever the app is resubmitted for review.
REVIEWER_PHONE=0500000099
REVIEWER_OTP=123456
