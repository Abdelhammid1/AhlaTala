<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only: allow cleartext HTTP so `flutter run` against a local
  Flask backend (10.0.2.2 for emulator, 127.0.0.1 via adb reverse for phone,
  or your LAN IP for wireless dev) keeps working. This file is NOT compiled
  into the release APK/AAB — release uses main/res/xml/network_security_config.xml
  which forbids cleartext.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
